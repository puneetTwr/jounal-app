# Single shared password that gates the entire application. There is no
# username — every session starts at a login screen that asks for just
# this password.
#
# Required. There is no default — the application fails fast on
# startup if this is missing or empty.
JOURNAL_AUTH_PASSWORD=

# Random, server-only secret used to sign session tokens. Never typed
# in by a person — generate it once (e.g. `openssl rand -hex 32`) and
# store it here. Rotating this value immediately invalidates every
# outstanding session, same as changing JOURNAL_AUTH_PASSWORD does.
#
# Required. There is no default — the application fails fast on
# startup if this is missing or empty.
SESSION_SECRET=

# Base32 shared secret for the second login factor (TOTP — a 6-digit
# authenticator-app code). Generate one with `npm run totp:generate`,
# which also prints the manual-entry key / otpauth:// URI to add it to
# an authenticator app (Google Authenticator, Authy, 1Password, etc.).
#
# Required. There is no default — the application fails fast on
# startup if this is missing or empty.
TOTP_SECRET=

# Which JournalRepository/TemplateRepository implementation is active:
#
# "filesystem" (default): read/write journal content as Markdown files
# on local disk, at JOURNAL_CONTENT_ROOT. Used by local development and
# any host with a real persistent disk (see ADR-001).
#
# "github-api": read/write journal content through GitHub's API instead
# of local disk, for hosts with no persistent filesystem (e.g. Vercel —
# see docs/architecture/ADR-002-github-api-storage-for-vercel.md).
# Requires JOURNAL_CONTENT_GIT_REMOTE_URL and JOURNAL_CONTENT_GIT_TOKEN
# to both be set (see below) — the app fails fast at startup if either
# is missing in this mode. JOURNAL_CONTENT_ROOT is not used in this mode.
#
# Optional. Defaults to "filesystem" if unset.
JOURNAL_STORAGE_BACKEND=

# Absolute filesystem path to the journal content repository (Markdown
# entries, attachments, templates, etc). Only used when
# JOURNAL_STORAGE_BACKEND is "filesystem" (or unset). This may point
# anywhere on disk, including a directory that is itself a separate Git
# repository from this application's own codebase.
#
# Required when JOURNAL_STORAGE_BACKEND is "filesystem" or unset. There
# is no default — the application fails fast on startup if this is
# missing or empty rather than falling back to a conventional location
# such as "./content".
JOURNAL_CONTENT_ROOT=

# Git-backed content repository. Both vars are required when
# JOURNAL_STORAGE_BACKEND=github-api (they're the only place journal
# content lives in that mode). When JOURNAL_STORAGE_BACKEND is
# "filesystem" (or unset), they're optional and only power the "Backup
# to Git"/"Restore from Git" buttons — if either is missing there, the
# buttons render in a clear "not configured" state rather than failing
# at startup.
#
# HTTPS remote URL of the private content repository.
JOURNAL_CONTENT_GIT_REMOTE_URL=

# A personal access token with read/write access to that repository.
# Used only in-memory (via a short-lived env var passed to the `git`
# child process for the filesystem backend's push/fetch, or as a
# bearer token for the github-api backend's REST calls) — never written
# to .git/config or logged.
JOURNAL_CONTENT_GIT_TOKEN=

# Which hosting platform's edge proxy sits in front of this app, if
# any — determines which request header the login rate limiter trusts
# as the real client IP (see SECURITY_HARDENING_CHECKLIST.md item 3).
# One of "fly", "railway", "render", "vercel", or "none".
#
# Optional. Defaults to "none" (untrusted — every request is bucketed
# under "unknown" for rate-limiting purposes) if unset or unrecognized.
# Deliberately fails toward *more* conservative rate limiting on a typo,
# never toward trusting a header a client could otherwise spoof.
TRUSTED_PROXY=

# Comma-separated origin(s) allowed to bypass Next's Server Actions
# same-origin CSRF check (e.g. a custom domain and/or the platform's own
# *.vercel.app URL) — bare hosts, no "https://" prefix, wildcard
# subdomains allowed (e.g. "my-journal.vercel.app,*.example.com").
#
# Optional. Leave unset until a stable production domain exists — Next's
# own default same-origin inference is enough until then (see
# SECURITY_HARDENING_CHECKLIST.md item 14).
PRODUCTION_ORIGIN=
