# Absolute filesystem path to the journal content repository (Markdown
# entries, attachments, templates, etc). This may point anywhere on
# disk, including a directory that is itself a separate Git repository
# from this application's own codebase.
#
# Required. There is no default — the application fails fast on
# startup if this is missing or empty rather than falling back to a
# conventional location such as "./content".
JOURNAL_CONTENT_ROOT=

# Git backup feature (optional): a private remote repository the
# "Backup to Git" button stages, commits, and pushes the content root
# to. Both vars must be set for the button to work — if either is
# missing, the button renders in a clear "not configured" state rather
# than failing at startup.
#
# HTTPS remote URL of the private content backup repository.
JOURNAL_CONTENT_GIT_REMOTE_URL=

# A personal access token with push access to that repository. Used
# only in-memory at push time (via a short-lived env var passed to the
# `git` child process) — never written to .git/config or logged.
JOURNAL_CONTENT_GIT_TOKEN=
